<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom Shadow / Raised Depth -->
    <item android:top="3dp" android:left="1.5dp" android:right="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#880E4F" />
        </shape>
    </item>
    <!-- Top Button surface -->
    <item android:bottom="3dp" android:left="1.5dp" android:right="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:startColor="#EC4899"
                android:endColor="#D81B60"
                android:angle="270" />
            <stroke
                android:width="1.2dp"
                android:color="#FFC2E0" />
        </shape>
    </item>
</layer-list>
