<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom Shadow / Raised Depth -->
    <item android:top="2dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#7A1A1A" />
        </shape>
    </item>
    <!-- Top Button surface -->
    <item android:bottom="2dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:startColor="#FF4B4B"
                android:endColor="#EF4444"
                android:angle="270" />
            <stroke
                android:width="1dp"
                android:color="#FFAAAA" />
        </shape>
    </item>
</layer-list>
