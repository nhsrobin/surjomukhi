<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 3D bottom raised shadow/base (deep dark charcoal base) -->
    <item android:top="4dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#06060A" />
        </shape>
    </item>
    <!-- Top premium surface with deep dark midnight/slate background -->
    <item android:bottom="4dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#09090F"
                android:centerColor="#11111A"
                android:endColor="#171724"
                android:angle="135" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1.8dp"
                android:color="#222235" />
        </shape>
    </item>
</layer-list>
