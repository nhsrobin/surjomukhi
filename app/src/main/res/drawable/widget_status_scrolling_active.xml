<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#590F37" />
        </shape>
    </item>
    <item android:bottom="2dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <gradient
                android:startColor="#4D1B37"
                android:endColor="#330F22"
                android:angle="270" />
            <stroke
                android:width="2.2dp"
                android:color="#EC4899" />
        </shape>
    </item>
</layer-list>
