<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow lift -->
    <item android:top="2dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#0F1E38" />
        </shape>
    </item>
    <!-- Surface -->
    <item android:bottom="2dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient
                android:startColor="#182A4A"
                android:endColor="#0D1A30"
                android:angle="270" />
            <stroke
                android:width="1dp"
                android:color="#3B82F6" />
        </shape>
    </item>
</layer-list>
