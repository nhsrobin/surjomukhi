<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_3d">

    <!-- Translucent Sunflower 3D watermark background overlay -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/surjomukhi_logo"
        android:scaleType="centerInside"
        android:alpha="0.18"
        android:padding="20dp" />

    <LinearLayout
        android:id="@+id/widget_main_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="visible">

        <!-- Row 1: Header + Company Watermark -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <ImageView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true" />

            <!-- by TasfiwnLabs Watermark in stylish font, reduced opacity -->
            <TextView
                android:id="@+id/widget_watermark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="by TasfiwnLabs"
                android:textColor="#55FFFFFF"
                android:textSize="9.5sp"
                android:textStyle="italic"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04" />
        </RelativeLayout>

        <!-- Row 2: Two rows of Quick Status Change Buttons (Reduced gaps for higher density) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="10dp"
            android:paddingHorizontal="2dp">

            <!-- Line 1: 4 Status Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:weightSum="4"
                android:layout_marginBottom="2dp">

                <!-- 1. Free -->
                <LinearLayout
                    android:id="@+id/btn_status_free"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingVertical="6dp"
                    android:paddingHorizontal="2dp"
                    android:layout_margin="1dp"
                    android:background="@drawable/widget_button_status_inactive"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:id="@+id/text_status_free"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/hind_siliguri_bold"
                        android:text="😎 ফ্রি"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:singleLine="true" />
                </LinearLayout>

                <!-- 2. Studying -->
                <LinearLayout
                    android:id="@+id/btn_status_focus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingVertical="6dp"
                    android:paddingHorizontal="2dp"
                    android:layout_margin="1dp"
                    android:background="@drawable/widget_button_status_inactive"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:id="@+id/text_status_focus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/hind_siliguri_bold"
                        android:text="🧠 পড়ছি"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:singleLine="true" />
                </LinearLayout>

                <!-- 3. Sleeping -->
                <LinearLayout
                    android:id="@+id/btn_status_sleep"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingVertical="6dp"
                    android:paddingHorizontal="2dp"
                    android:layout_margin="1dp"
                    android:background="@drawable/widget_button_status_inactive"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:id="@+id/text_status_sleep"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/hind_siliguri_bold"
                        android:text="💤 ঘুম"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:singleLine="true" />
                </LinearLayout>

                <!-- 4. Scrolling -->
                <LinearLayout
                    android:id="@+id/btn_status_scrolling"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingVertical="6dp"
                    android:paddingHorizontal="2dp"
                    android:layout_margin="1dp"
                    android:background="@drawable/widget_button_status_inactive"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:id="@+id/text_status_scrolling"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/hind_siliguri_bold"
                        android:text="📱 স্ক্রল"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:singleLine="true" />
                </LinearLayout>
            </LinearLayout>

            <!-- Line 2: 4 Status Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:weightSum="4">

                <!-- 5. Talking -->
                <LinearLayout
                    android:id="@+id/btn_status_talking"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingVertical="6dp"
                    android:paddingHorizontal="2dp"
                    android:layout_margin="1dp"
                    android:background="@drawable/widget_button_status_inactive"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:id="@+id/text_status_talking"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/hind_siliguri_bold"
                        android:text="📞 কলে"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:singleLine="true" />
                </LinearLayout>

                <!-- 6. Home -->
                <LinearLayout
                    android:id="@+id/btn_status_home"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingVertical="6dp"
                    android:paddingHorizontal="2dp"
                    android:layout_margin="1dp"
                    android:background="@drawable/widget_button_status_inactive"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:id="@+id/text_status_home"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/hind_siliguri_bold"
                        android:text="🏠 বাসায়"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:singleLine="true" />
                </LinearLayout>

                <!-- 7. Offline -->
                <LinearLayout
                    android:id="@+id/btn_status_offline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingVertical="6dp"
                    android:paddingHorizontal="2dp"
                    android:layout_margin="1dp"
                    android:background="@drawable/widget_button_status_inactive"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:id="@+id/text_status_offline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/hind_siliguri_bold"
                        android:text="📡 অফ"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:singleLine="true" />
                </LinearLayout>

                <!-- 8. Busy -->
                <LinearLayout
                    android:id="@+id/btn_status_busy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingVertical="6dp"
                    android:paddingHorizontal="2dp"
                    android:layout_margin="1dp"
                    android:background="@drawable/widget_button_status_inactive"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:id="@+id/text_status_busy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/hind_siliguri_bold"
                        android:text="🔴 ব্যস্ত"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:singleLine="true" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Row 3: Smaller Partner Status Panel with a 3D Heart Bell Button beside it -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp">

            <!-- Partner Status Card -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_partner_card_3d"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="8dp"
                android:paddingHorizontal="10dp">

                <!-- Status metrics column -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/widget_other_status_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <ImageView
                        android:id="@+id/widget_other_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

                <!-- Big 3D Vibe Avatar displaying dynamically based on state -->
                <TextView
                    android:id="@+id/widget_partner_avatar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:paddingStart="4dp"
                    android:paddingEnd="2dp"
                    android:text="😎"
                    android:textSize="32sp" />
            </LinearLayout>

            <!-- 3D Heart Bell Button (Triggers PING vibe on click) -->
            <LinearLayout
                android:id="@+id/widget_heart_ping_btn"
                android:layout_width="54dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:background="@drawable/widget_heart_button_3d"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💖"
                    android:textSize="22sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Row 4 (Overlay): Chirkut (চিরকুট) container -->
    <LinearLayout
        android:id="@+id/widget_chirkut_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_chirkut_bg"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <!-- Left side: Chirkut Note text rendered dynamically -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_chirkut_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="চিরকুট এসেছে 💖"
                android:textColor="#E0F2FE"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:fontFamily="@font/hind_siliguri_bold"
                android:layout_marginBottom="4dp" />

            <!-- We render the beautiful Bengali message dynamically here -->
            <ImageView
                android:id="@+id/widget_chirkut_text_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Right side: Cute 3D relationship mascot -->
        <ImageView
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:layout_gravity="center_vertical"
            android:src="@drawable/img_chirkut_mascot"
            android:scaleType="centerCrop"
            android:layout_marginStart="8dp" />
    </LinearLayout>
</FrameLayout>
